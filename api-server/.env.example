# Example .env configuration for Destiny Chronicle PGCR API

# Server configuration
PGCR_API_PORT=3001
PGCR_ENABLE_CORS=true
PGCR_LOG_LEVEL=info

# Archive Parquet paths
# Adjust these paths based on your environment:
# - Windows local: D:\DestinyChronicleDB\...
# - Windows mapped drive: Z:\DestinyChronicleDB\...
# - Windows UNC: \\ARCHIVE-HOST\DestinyChronicleDB\...
# - Linux/Mac mount: /mnt/archive-host/DestinyChronicleDB/...

PGCR_LEAN_ACTIVITIES_PATH=D:\DestinyChronicleDB\lean\splashbear_activities.parquet
PGCR_MEMBERSHIP_PATH=D:\DestinyChronicleDB\by_membership\splashbear.parquet
PGCR_WATERMARK_PATH=D:\DestinyChronicleDB\coverage_watermark.json

# Player activities lite path (optional, defaults to PGCR_LEAN_ACTIVITIES_PATH)
# Use this to point to a lighter-weight parquet file optimized for cold-start queries
# PLAYER_ACTIVITIES_LITE_PATH=D:\DestinyChronicleDB\lean\player_activities_lite_6acct.parquet

# Multi-tier archive paths (optional)
# Per-mid light extracts (tier 2): directory containing per-player parquet files
# MID_LIGHT_EXTRACT_DIR=D:\DestinyChronicleDB\lean\mid_light_extract
#
# Compact mid index (tier 3): directory containing bucketed instance ID index
# COMPACT_INDEX_ROOT=D:\DestinyChronicleDB\cl_mid_index_compact

# Destiny 1 index paths (optional, off by default)
# Both D1_INDEX_ROOT and D1_PLAYED_WITH_ROOT typically point to the same parent folder
# which contains both act/ and pw/ subdirectories (e.g., D:\d1\final contains act/ and pw/)
# Total size: ~43 GB (act ~30.2 GB + pw ~13.0 GB)
#
# D1 activity index: D1_INDEX_ROOT/act/mid_bucket=N/instances.parquet
# D1_INDEX_ROOT=D:\d1\final
#
# D1 played-with: D1_PLAYED_WITH_ROOT/pw/iid_band=N/pw.parquet  
# D1_PLAYED_WITH_ROOT=D:\d1\final

# Brief 5 Option A — gap ready/ dual-root (staging only; default OFF)
# Point a SEPARATE process (e.g. PGCR_API_PORT=3002) at gap ready/; do not enable on live :3001.
# GAP_INDEX_ROOT=E:\DestinyChronicleDB\cl_mid_index_gap\ready
# ENABLE_GAP_LEAN=true

# Bungie API configuration (for live fallback)
# Get your API key from https://www.bungie.net/en/Application
BUNGIE_API_KEY=your_bungie_api_key_here
BUNGIE_API_ROOT=https://www.bungie.net/Platform

# Fix-on-view for flagged PGCRs (optional)
# Flag lookup directory containing band_*.bin files (built by build-flag-lookup.ts)
# FLAG_LOOKUP_ROOT=D:\DestinyChronicleDB\flag_lookup
#
# Override store directory for corrected PGCRs
# PGCR_OVERRIDE_STORE_ROOT=D:\DestinyChronicleDB\pgcr_overrides
#
# Enable fix-on-view feature (default: false)
# FIX_ON_VIEW_ENABLED=true
#
# Max wait time for Bungie fetch on first view (ms, default: 2000)
# 0 = return immediately, 1000-3000 = brief wait (recommended)
# FIX_ON_VIEW_WAIT_MS=2000
#
# Flag filter mode (default: "all")
# "all" = All flagged IDs regardless of mode/rule
# "sharp" = Skip rule A in modes 2,4,6,82; L only for mode 40
# FLAG_FILTER=all
