# Played With summary worker settings (copy to worker.env and fill in; never commit the real file).
PLAYED_WITH_SUMMARY_DIR=<data drive>\DestinyChronicleDB\played_with_summaries
PLAYED_WITH_SUMMARY_API=http://127.0.0.1:3001
PLAYED_WITH_LEGACY_ROOT=<drive>\DestinyChronicleDB\played_with_index\by_iid_1m
PLAYED_WITH_COMPACT_ROOT=<drive>\DestinyChronicleDB\played_with_index_10_16b\by_iid_1m
PLAYED_WITH_DUCKDB_TEMP_DIR=<data drive>\DestinyChronicleDB\_pw_duckdb_tmp
PLAYED_WITH_DUCKDB_THREADS=4
PLAYED_WITH_DUCKDB_MEMORY=3GB
PLAYED_WITH_SUMMARY_PARTNERS=1000
PLAYED_WITH_REFRESH_HOURS=168# Games newer than the archive are filled from Bungie (key file is read by the worker; never logged).
BUNGIE_API_KEY_FILE=D:\DCServer\secrets\bungie.key
PLAYED_WITH_POST_ARCHIVE_DIR=D:\DestinyChronicleDB\pgcr_post_archive
PLAYED_WITH_BUNGIE_PARALLEL=10
PLAYED_WITH_NAME_TOP=2000
