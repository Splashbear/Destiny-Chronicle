@echo off
REM Copy to home-pc.env and edit. Hardware-agnostic: set roots to YOUR drives.
REM Do not commit home-pc.env (may contain local paths).

REM --- Listen ---
set PGCR_API_PORT=3001
set PGCR_ENABLE_CORS=true
REM GitHub Pages origin only (no wildcard)
set PGCR_CORS_ORIGIN=https://splashbear.github.io
set PGCR_LOG_LEVEL=info
set PGCR_LOG_DIR=D:\DestinyChronicleDB\logs

REM --- DuckDB / speed (tune to RAM: 8GB machine use 2-4GB; 32GB use 8-16GB) ---
set PGCR_DUCKDB_THREADS=4
set PGCR_DUCKDB_MEMORY=4GB
set PGCR_MAX_ACTIVITIES_LIMIT=100000
set PGCR_BATCH_CONCURRENCY=2

REM --- Data roots (CHANGE THESE) ---
set COMPACT_INDEX_ROOT=D:\DestinyChronicleDB\cl_mid_index_compact
set GAP_INDEX_ROOT=D:\DestinyChronicleDB\cl_mid_index_gap\ready
set GAP_INDEX_SORTED_ROOT=D:\DestinyChronicleDB\cl_mid_index_gap\ready_by_mid
set PGCR_WATERMARK_PATH=D:\DestinyChronicleDB\coverage_watermark.json
set PLAYER_ACTIVITIES_LITE_PATH=D:\DestinyChronicleDB\lean\player_activities_lite.parquet
set MID_LIGHT_EXTRACT_DIR=D:\DestinyChronicleDB\lean
set PGCR_LEAN_ACTIVITIES_PATH=D:\DestinyChronicleDB\lean\splashbear_activities.parquet
set PGCR_MEMBERSHIP_PATH=D:\DestinyChronicleDB\by_membership\splashbear.parquet

REM Gap lean ON for home archive serve; leave OFF until data validated on this PC
set ENABLE_GAP_LEAN=true

REM Played With index (optional; omit or leave empty on 1 TB config)
REM set PLAYED_WITH_ROOT=D:\DestinyChronicleDB\played_with_index
