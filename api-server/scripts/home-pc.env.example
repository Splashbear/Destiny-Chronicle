@echo off
REM Copy to home-pc.env and edit. Hardware-agnostic: set roots to YOUR drives.
REM Do not commit home-pc.env (may contain local paths).

REM --- Listen ---
set PGCR_API_PORT=3001
set PGCR_ENABLE_CORS=true
REM GitHub Pages origin only (no wildcard)
set PGCR_CORS_ORIGIN=https://splashbear.github.io
set PGCR_LOG_LEVEL=info
set PGCR_LOG_DIR=D:\DestinyChronicleDB\logs

REM --- DuckDB / speed (tune to RAM: 8GB machine use 2-4GB; 32GB use 8-16GB) ---
set PGCR_DUCKDB_THREADS=4
set PGCR_DUCKDB_MEMORY=4GB
set PGCR_MAX_ACTIVITIES_LIMIT=100000
set PGCR_BATCH_CONCURRENCY=2

REM --- Data roots (CHANGE THESE) ---
set COMPACT_INDEX_ROOT=D:\DestinyChronicleDB\cl_mid_index_compact
set GAP_INDEX_ROOT=D:\DestinyChronicleDB\cl_mid_index_gap\ready
set GAP_INDEX_SORTED_ROOT=D:\DestinyChronicleDB\cl_mid_index_gap\ready_by_mid
set PGCR_WATERMARK_PATH=D:\DestinyChronicleDB\coverage_watermark.json
set PLAYER_ACTIVITIES_LITE_PATH=D:\DestinyChronicleDB\lean\player_activities_lite.parquet
set MID_LIGHT_EXTRACT_DIR=D:\DestinyChronicleDB\lean
set PGCR_LEAN_ACTIVITIES_PATH=D:\DestinyChronicleDB\lean\splashbear_activities.parquet
set PGCR_MEMBERSHIP_PATH=D:\DestinyChronicleDB\by_membership\splashbear.parquet

REM Gap lean ON for home archive serve; leave OFF until data validated on this PC
set ENABLE_GAP_LEAN=true

REM Played With index (optional; omit or leave empty on 1 TB config)
REM Played With is read from two band indexes, routed by instance id:
REM   legacy  (below PLAYED_WITH_SPLIT_IID, default 10000000000): string format with names
REM   compact (split .. PLAYED_WITH_COMPACT_MAX_IID, default 16000000000): shrunk numeric format
REM Compact bands are read only when their build done marker exists (PLAYED_WITH_COMPACT_DONE_DIR,
REM default <compact root>\..\_w38_state\done); other games report partial coverage -> Bungie.
REM set PLAYED_WITH_LEGACY_ROOT=X:\path\to\played_with_index\by_iid_1m
REM set PLAYED_WITH_COMPACT_ROOT=Y:\path\to\played_with_index_10_16b\by_iid_1m
REM set PLAYED_WITH_COMPACT_DONE_DIR=Y:\path\to\played_with_index_10_16b\_w38_state\done
REM set PLAYED_WITH_DUCKDB_THREADS=2
REM set PLAYED_WITH_DUCKDB_MEMORY=2GB
REM DuckDB spill folder on a data drive (default: <index parent>\_duckdb_tmp). Never point at C: or the server folder.
REM set PLAYED_WITH_DUCKDB_TEMP_DIR=Z:\path\to\scratch\played_with_duckdb_tmp
REM Extra bot membership ids to skip (comma-separated); known checkpoint bots are built in.
REM set PLAYED_WITH_EXCLUDE_IDS=
REM (PLAYED_WITH_ROOT is still accepted as the legacy root.)
REM Minimal index for both ranges (instance_id, membership_id, period, activity_hash, mode). Bands with a marker in
REM <root>\markers\{legacy,compact}\N.json are read from <root>\{legacy,compact}\by_iid_1m; others fall back to the roots above.
REM set PLAYED_WITH_MIN_ROOT=Z:\path\to\pw_min
REM Name-range table (mid, name, first_seen, last_seen); names every partner, else 'Private Guardian'.
REM set PLAYED_WITH_NAME_TABLE=Z:\path\to\pw_min\names\*.parquet

# Played With: refresh the top N partners' names to their current Bungie name on each page load (0 = off).
# Cached on disk 24h (partner ids + names only). Capped per minute across all visitors; failures keep the index name.
#PLAYED_WITH_NAME_REFRESH_TOP=25
#PLAYED_WITH_NAME_CACHE=E:/DestinyChronicleDB/pw_min/partner_names_cache.json
#PLAYED_WITH_NAME_REFRESH_BUDGET_MS=4000
#PLAYED_WITH_NAME_REFRESH_PER_MIN=120
