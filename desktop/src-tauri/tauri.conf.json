{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Destiny Chronicle",
  "version": "0.1.0",
  "identifier": "com.splashbear.destiny-chronicle",
  "build": {
    "beforeDevCommand": "npm run build:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/destiny-chronicle/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Destiny Chronicle",
        "width": 1280,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
